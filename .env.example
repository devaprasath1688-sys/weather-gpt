# Copy to .env.local for local development.
# Never put secret keys in NEXT_PUBLIC_* variables.
# Do not commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (anon key is designed for the browser; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Weather Provider Configuration (Server-Only)
# By default, Phase 2 uses Open-Meteo High-Res Engine (no API key required).
# Optional: Set WEATHER_API_KEY and WEATHER_API_BASE_URL to switch to WeatherAPI or OpenWeatherMap.
WEATHER_API_KEY=
WEATHER_API_BASE_URL=
WEATHER_PROVIDER=open-meteo

# Official alert / government feed ingest (server-only - Phase 5)
OFFICIAL_ALERTS_INGEST_KEY=

# LLM provider (server-only - Phase 3)
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=

# Mapbox — public token only (Phase 4). Restrict by URL in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Web Push (private VAPID key is server-only - Phase 7)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Speech-to-text / text-to-speech (server-only - Phase 6)
STT_API_KEY=
TTS_API_KEY=
