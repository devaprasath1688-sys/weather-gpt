# WeatherGPT Environment Configuration

# Supabase Authentication & Database (Optional - App falls back to local demo mode if not set)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps API Key (Optional - App defaults to high-resolution OpenStreetMap & Esri Satellite)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Custom Road Map Tile URL (Optional - App defaults to free OpenStreetMap: https://tile.openstreetmap.org/{z}/{x}/{y}.png)
# Example custom tile endpoint: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
